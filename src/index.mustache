<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {{#catalogBridge}}
    <meta name="todo-list-catalog-bridge" content="{{{path}}}" />
    {{/catalogBridge}}
    {{#travelBridge}}
    <meta name="todo-list-travel-bridge" content="{{{path}}}" />
    {{/travelBridge}}
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{{assets.stylesheet}}}" />
    {{#pageStylesheet}}
    <link rel="stylesheet" href="{{{pageStylesheet}}}" />
    {{/pageStylesheet}}
    <script type="importmap">
      {
        "imports": {
          "react": "{{{imports.react}}}",
          "react/jsx-runtime": "{{{imports.reactJsxRuntime}}}",
          "react-dom/client": "{{{imports.reactDomClient}}}"
          {{#imports.travelMap}},
          "d3": "{{{d3}}}",
          "d3-hexgrid": "{{{hexgrid}}}"
          {{/imports.travelMap}}
        }
      }
    </script>
  </head>
  <body>
    <div id="app-root"></div>
    <script type="module" src="{{{assets.script}}}"></script>
  </body>
</html>
